DEF FLOOR Solid {
  translation 2.5 0 -0.05
  name "floor"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.55 0.57 0.60 roughness 0.95 metalness 0 }
      geometry DEF FLOOR_BO Box { size 6.0 2.0 0.1 }
    }
  ]
  boundingObject USE FLOOR_BO
}
SimpleConveyor {
  translation 2.5 0 0
  name "belt_demo"
  size 5.0 0.5 0.82
  speed 1.0
  borderHeight 0
}
